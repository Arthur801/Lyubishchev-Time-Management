[Unit]
Description=LTM OpenAI time trend analysis service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ltm/OpenAiTrendAnalysis
EnvironmentFile=/etc/ltm/ltm-ai-trend.env
ExecStart=/opt/ltm/OpenAiTrendAnalysis/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8011
Restart=on-failure
RestartSec=5
User=ltm
Group=ltm

[Install]
WantedBy=multi-user.target
