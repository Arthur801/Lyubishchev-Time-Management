@{
    ViewData["Title"] = "儀表板";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page" id="dashboard-page">
    <aside class="app-sidebar" aria-label="主要導覽">
        <a class="app-brand" asp-controller="Dashboard" asp-action="Index" aria-label="LTM 儀表板"><span>LTM</span><small>TIME LOG</small></a>
        <nav class="app-nav">
            <a class="app-nav__link app-nav__link--active" asp-controller="Dashboard" asp-action="Index" aria-current="page"><span aria-hidden="true">◈</span>儀表板</a>
            <a class="app-nav__link" asp-controller="TimeEntry" asp-action="Index"><span aria-hidden="true">◷</span>歷史紀錄</a>
            <a class="app-nav__link" asp-controller="Report" asp-action="Index"><span aria-hidden="true">▥</span>報表</a>
            <a class="app-nav__link" asp-controller="Category" asp-action="Index"><span aria-hidden="true">◌</span>分類</a>
            <a class="app-nav__link" asp-controller="Tag" asp-action="Index"><span aria-hidden="true">#</span>標籤</a>
            <a class="app-nav__link" asp-controller="Settings" asp-action="Index"><span aria-hidden="true">⚙</span>設定</a>
        </nav>
        <a class="app-nav__link app-nav__link--logout" href="#"><span aria-hidden="true">↗</span>登出</a>
    </aside>

    <header class="mobile-header">
        <a class="app-brand" asp-controller="Dashboard" asp-action="Index" aria-label="LTM 儀表板"><span>LTM</span><small>TIME LOG</small></a>
    </header>

    <main class="dashboard-content" id="dashboard-content">
        <header class="page-heading">
            <div><p class="eyebrow">時間總覽</p><h1>你的時間，正在累積。</h1><p id="range-label">載入中…</p></div>
            <div class="range-controls" aria-label="選擇統計日期範圍">
                <div class="range-presets" role="group" aria-label="快捷日期範圍">
                    <button type="button" class="range-button range-button--active" data-range="today" aria-pressed="true">今天</button>
                    <button type="button" class="range-button" data-range="week" aria-pressed="false">本週</button>
                    <button type="button" class="range-button" data-range="month" aria-pressed="false">本月</button>
                    <button type="button" class="range-button" id="range-custom" data-range="custom" aria-pressed="false">自訂</button>
                </div>
                <div class="custom-range" id="custom-range" hidden>
                    <label>開始日期<input id="range-start" type="date"></label>
                    <label>結束日期<input id="range-end" type="date"></label>
                    <button class="outline-button" id="apply-range" type="button">套用</button>
                </div>
                <p class="form-message" id="range-error" aria-live="polite"></p>
            </div>
        </header>

        <section class="timer-card" aria-labelledby="timer-heading">
            <div class="timer-card__intro"><p class="eyebrow">現在正在記錄</p><h2 id="timer-heading">把注意力留給一件事</h2></div>
            <div class="timer-card__fields">
                <label>活動名稱<input id="timer-name" type="text" maxlength="80"></label>
                <label>分類<select id="timer-category"><option value="">未分類</option></select></label>
                <div class="tag-editor"><span class="field-label">標籤</span><div id="timer-tags" class="tag-list" aria-label="目前標籤"></div><div class="add-tag"><input id="tag-input" type="text" maxlength="24" placeholder="新增標籤"><button id="add-tag" type="button">加入</button></div></div>
            </div>
            <div class="timer-card__action"><p class="timer-status" id="timer-status" aria-live="polite">尚未開始計時</p><output class="timer-display" id="timer-display" aria-label="計時時間">00:00:00</output><button class="timer-toggle" id="timer-toggle" type="button" aria-pressed="false">開始計時</button></div>
        </section>

        <section class="summary-grid" aria-label="本期統計摘要">
            <article class="summary-card summary-card--primary"><p>本期總追蹤時間</p><strong id="total-duration">載入中…</strong><span id="change-summary"></span></article>
            <article class="summary-card"><p>最投入的分類</p><strong id="top-category">—</strong><span id="top-category-duration"></span></article>
            <article class="summary-card"><p>常用標籤</p><strong id="top-tag">—</strong><span id="top-tag-duration"></span></article>
        </section>

        <section class="analytics-grid" aria-label="時間分析">
            <article class="dashboard-panel dashboard-panel--trend"><header><div><p class="eyebrow">每日趨勢</p><h2>時間分布</h2></div><span class="panel-note">單位：小時</span></header><div id="trend-chart" class="trend-chart" role="img" aria-label="每日追蹤時間趨勢"></div><p id="trend-summary" class="visually-hidden" aria-live="polite"></p></article>
            <article class="dashboard-panel"><header><div><p class="eyebrow">分類</p><h2>投入比例</h2></div></header><div class="donut-layout"><div id="category-donut" class="category-donut" role="img" aria-label="分類時間分布"><span id="donut-total"></span></div><ul id="category-legend" class="chart-legend"></ul></div></article>
            <article class="dashboard-panel"><header><div><p class="eyebrow">標籤</p><h2>關注主題</h2></div><span class="panel-note">可重複累計</span></header><div id="tag-chart" class="tag-chart" role="img" aria-label="標籤時間分布"></div></article>
            <article class="dashboard-panel dashboard-panel--recent"><header><div><p class="eyebrow">最近活動</p><h2>剛完成的紀錄</h2></div><a asp-controller="TimeEntry" asp-action="Index" class="text-link">查看全部</a></header><ol id="recent-list" class="recent-list"></ol></article>
        </section>
    </main>

    <partial name="_MobileNavigation" model="@("dashboard")" />
</div>

@section Scripts {
    <script type="module" src="~/js/timer.js" asp-append-version="true"></script>
    <script type="module" src="~/js/dashboard.js" asp-append-version="true"></script>
}
