@{
    ViewData["Title"] = "設定";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
}

<div class="dashboard-page" id="settings-page">
    <aside class="app-sidebar" aria-label="主要導覽">
        <a class="app-brand" asp-controller="Dashboard" asp-action="Index" aria-label="LTM 儀表板"><span>LTM</span><small>TIME LOG</small></a>
        <nav class="app-nav">
            <a class="app-nav__link" asp-controller="Dashboard" asp-action="Index"><span aria-hidden="true">◈</span>儀表板</a>
            <a class="app-nav__link" asp-controller="TimeEntry" asp-action="Index"><span aria-hidden="true">◷</span>歷史紀錄</a>
            <a class="app-nav__link" asp-controller="Report" asp-action="Index"><span aria-hidden="true">▥</span>報表</a>
            <a class="app-nav__link" asp-controller="Category" asp-action="Index"><span aria-hidden="true">◌</span>分類</a>
            <a class="app-nav__link" asp-controller="Tag" asp-action="Index"><span aria-hidden="true">#</span>標籤</a>
            <a class="app-nav__link app-nav__link--active" asp-controller="Settings" asp-action="Index" aria-current="page"><span aria-hidden="true">⚙</span>設定</a>
        </nav>
        <a class="app-nav__link app-nav__link--logout" href="#"><span aria-hidden="true">↗</span>登出</a>
    </aside>

    <header class="mobile-header">
        <a class="app-brand" asp-controller="Dashboard" asp-action="Index" aria-label="LTM 儀表板"><span>LTM</span><small>TIME LOG</small></a>
        <button class="icon-button" type="button" aria-label="開啟設定">⚙</button>
    </header>

    <main class="dashboard-content settings-content">
        <header class="page-heading">
            <div>
                <p class="eyebrow">設定</p>
                <h1>選擇你的時區。</h1>
                <p id="browser-timezone-hint" class="settings-hint"></p>
            </div>
        </header>

        <form id="timezone-form" class="settings-card">
            <label for="timezone-select">時區</label>
            <select id="timezone-select" required></select>
            <p id="timezone-message" class="form-message" role="alert" aria-live="polite"></p>
            <button id="timezone-save" class="primary-button" type="submit">儲存</button>
        </form>
    </main>
</div>

@section Scripts {
    <script type="module" src="~/js/settings.js" asp-append-version="true"></script>
}
